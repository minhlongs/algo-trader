    {
      "type": "gauge",
      "title": "L4 paper gate days remaining",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "algo_trader_qwen_paper_gate_days_remaining", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 30,
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "type": "row",
      "title": "Paper Performance (24h rolling)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Qwen paper P&L % (24h rolling)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "algo_trader_qwen_paper_pnl_pct * 100", "refId": "A", "legendFormat": "P&L %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -5 },
              { "color": "green", "value": 0 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Signals ingested (5m rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(algo_trader_qwen_signals_total[5m])", "refId": "A", "legendFormat": "{{result}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "row",
      "title": "Signals Loop (L0 Dynamic)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Loop runs by decision (24h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (decision) (increase(algo_trader_qwen_signals_loop_runs_total[24h]))",
          "refId": "A",
          "legendFormat": "{{decision}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "table" } }
    },
    {
      "type": "bargauge",
      "title": "Strategy reviews queued by reason (7d)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (increase(algo_trader_qwen_strategy_reviews_queued_total[7d]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "type": "row",
      "title": "Liveness & Review Queue (2026-04-17)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Signals-loop freshness (min since last run)",
      "description": "time() − algo_trader_qwen_signals_loop_last_run_ts, expressed in minutes. Alert fires at >420min (7h).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(time() - algo_trader_qwen_signals_loop_last_run_ts) / 60", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 360 },
              { "color": "red", "value": 420 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Drawdown-monitor freshness (min since last run)",
      "description": "time() − algo_trader_qwen_drawdown_monitor_last_run_ts. Alert fires at >420min.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(time() - algo_trader_qwen_drawdown_monitor_last_run_ts) / 60", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 360 },
              { "color": "red", "value": 420 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Review backlog size",
      "description": "Current rows in strategy_review_tasks WHERE status='pending'. queued − resolved.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "algo_trader_qwen_strategy_review_backlog_size", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Oldest pending review (hours)",
      "description": "algo_trader_qwen_strategy_review_oldest_pending_age_sec / 3600. Alert fires at >48h.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "algo_trader_qwen_strategy_review_oldest_pending_age_sec / 3600", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "red", "value": 48 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Review queue flow: queued vs resolved (1h rate)",
      "description": "Positive queued rate = drift detected. Positive resolved rate = operator closing. Delta = backlog growth/shrink.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(algo_trader_qwen_strategy_reviews_queued_total[1h]))", "refId": "A", "legendFormat": "queued/s" },
        { "expr": "sum(rate(algo_trader_qwen_strategy_reviews_resolved_total[1h]))", "refId": "B", "legendFormat": "resolved/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Signals-loop journal-write errors (1h increase)",
      "description": "Non-zero = persistRunJournal INSERTs failing. With a stale freshness gauge, this attributes to DB rather than timer death.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(algo_trader_qwen_signals_loop_journal_write_errors_total[1h])", "refId": "A", "legendFormat": "DB-write errors" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70 }
        }
      }
    }
