# AlgoTrade Bot — Environment Configuration
# Copy: cp .env.example .env → fill in your credentials
# NEVER commit .env to git!

# ═══════════ REQUIRED FOR TRADING ═══════════

# Polymarket CLOB API (from polymarket.com → Settings → API Keys)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# ═══════════ LLM CONFIGURATION (Multi-Model M1 Max) ═══════════
# Port 4001: Nemotron-3-Nano-30B  (hot-idle, fast scan)
# Port 4002: DeepSeek-R1-32B      (hot, deep reasoning)
# Port 4003: Qwen2.5-Coder-7B     (hot-idle, code tasks)
# Port 11437: Qwen3-30B-A3B-4bit  (NEW — reasoning + trading signals)
# All servers on M1 Max, bound to 127.0.0.1 only

OPENCLAW_GATEWAY_URL=http://localhost:11435/v1
OPENCLAW_SCANNER_URL=http://localhost:11436/v1
OPENCLAW_MODEL_SIMPLE=
OPENCLAW_MODEL_STANDARD=
OPENCLAW_MODEL_COMPLEX=
OPENCLAW_TIMEOUT_MS=300000

# Qwen3-30B-A3B MLX server (Phase 01 — M1 Max provisioning)
QWEN_SERVER_URL=http://127.0.0.1:11437
QWEN_MODEL=mlx-community/Qwen3-30B-A3B-4bit

# ═══════════ QWEN SIGNAL DAEMON (Phase 03 — M1 Max daemon) ═══════════
# Shared HMAC secret between CF Worker and M1 Max daemon.
# Generate: openssl rand -hex 32
# Set SAME value in CF Worker env AND M1 Max ~/.zshenv
QWEN_INGEST_HMAC_SECRET=your-64-hex-char-secret-here

# Production ingest URL for the daemon to POST signals to
QWEN_SIGNAL_INGEST_URL=https://algo-trader.pages.dev/api/v1/signals/ingest

# Kill switch: set to any non-empty value to stop daemon after current cycle
QWEN_SIGNAL_KILL=

# ═══════════ QWEN PAPER-GATE + ROLLBACK (Phase 04) ═══════════

# L1 kill switch: set to '1' to block all new Qwen signal ingestion immediately
# Clear to '0' to re-enable (manual admin action only)
QWEN_KILL=0

# L4 live-eligibility flag: flip to 'true' ONLY after 30-day paper validation passes
# AND P&L is positive. Hardcoded 30-day gate still applies even when 'true'.
QWEN_LIVE_ELIGIBLE=false

# Auto-approve USD cap for Qwen trades going live (post-30d). Trades above this
# require manual approval via Telegram admin confirmation.
QWEN_AUTO_APPROVE_MAX_USD=500

# Drawdown threshold for auto-disable (L3). Default 5%.
# If 24h rolling P&L for source='qwen' drops below -N%, Qwen swarm is auto-disabled.
QWEN_DRAWDOWN_MAX_PCT=5

# Fallback LLM configuration (optional)
# LLM_PRIMARY_URL=
# LLM_PRIMARY_MODEL=
# LLM_FALLBACK_URL=
# LLM_FALLBACK_MODEL=

# ═══════════ DATA ═══════════

DATABASE_PATH=data/algo-trade.db

# ═══════════ TRADING DEFAULTS ═══════════

# Paper trading is ON by default (safe). Set to false for live execution.
PAPER_TRADING=true

# Starting capital in USDC
CAPITAL_USDC=200

# ═══════════ LICENSING (Required for RaaS mode) ═══════════

# LICENSE_KEY_PREFIX=raas
LICENSE_ACTIVATION_SECRET=your-32-byte-hex-string-for-activation
LICENSE_ENCRYPTION_KEY=your-32-byte-hex-string-for-encryption

# ═══════════ BILLING — NOWPayments (Crypto USDT TRC20) ═══════════

# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# USDT_TRC20_WALLET=
# NOWPAYMENTS_INVOICE_PRO=
# NOWPAYMENTS_INVOICE_ENTERPRISE=

# ═══════════ AUTHENTICATION (Better Auth) ═══════════
# BETTER_AUTH_SECRET=<random-32-char-string>
# BETTER_AUTH_URL=https://api.cashclaw.cc

# ═══════════ NOTIFICATIONS (Optional) ═══════════

# Telegram Alerts + Channel
# TELEGRAM_BOT_TOKEN=       # Required for drawdown-monitor alerts + Grafana qwen-telegram-admin contact point
# TELEGRAM_CHAT_ID=         # Admin chat for L3/L4/signals-loop alert fan-out (Grafana forwards via contact-points.yml)
# TELEGRAM_CHANNEL_ID=

# Twitter/X Auto-Posting (OAuth 1.0a)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# TWITTER_BEARER_TOKEN=

# Email Alerts (SendGrid)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=Algo Trader

# SMS Alerts (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ═══════════ INFRASTRUCTURE (Optional) ═══════════

# NATS Message Bus (event-driven architecture)
# If set, NATS is used for pub/sub. If empty, falls back to Redis pub/sub.
# NATS_URL=nats://localhost:4222
# NATS_TOKEN=   # REQUIRED in production — generate with: openssl rand -hex 32
# NATS_CLIENT_NAME=algo-trader

# Redis (for caching/queues)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Usage Metering
# USAGE_METERING_ENABLED=true
# OVERAGE_ENABLED=true
# OVERAGE_PRICE_PER_CALL=0.01

# Dunning
# DUNNING_ENABLED=true
# DUNNING_GRACE_PERIOD_DAYS=7

# Audit Logging
# AUDIT_LOG_ENABLED=true
# AUDIT_RETENTION_DAYS=90
# AUDIT_BATCH_SIZE=100

# Distributed tracing (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
