// ─── Public API — wrappers used across the codebase ──────────────────────────

// Candle data metrics (called by gap-detector.ts)
export function recordDataGap(provider: string, symbol: string, _duration: number): void {
  gapCounter().inc({ provider, symbol, gap_type: 'missing_candle' });
}
export function recordGapDetectionDuration(provider: string, symbol: string, durationSeconds: number): void {
  gapDurationHist().observe({ provider, symbol }, durationSeconds);
}
export function setCandleCompleteness(provider: string, symbol: string, timeframe: string, ratio: number): void {
  candleCompletenessGauge().set({ symbol }, ratio);
}
export function setExpectedCandles(provider: string, symbol: string, timeframe: string, count: number): void {
  expectedCandlesGauge().set({ symbol, timeframe, provider }, count);
}
export function setReceivedCandles(provider: string, symbol: string, timeframe: string, count: number): void {
  receivedCandlesGauge().set({ symbol, timeframe, provider }, count);
}

// Outlier metrics (called by outlier-detection.ts)
export function recordOutlierEvent(symbol: string, outlierType: string, _severity: string): void {
  outlierCounter().inc({ symbol, outlier_type: outlierType });
}
export function recordOutlierZScore(symbol: string, outlierType: string, zScore: number): void {
  outlierZScoreGauge().set({ symbol }, zScore);
}

// Provider failover metrics (called by provider-failover.ts)
export function recordFailoverEvent(fromProvider: string, toProvider: string, reasonType: string): void {
  failoverCounter().inc({ from_provider: fromProvider, to_provider: toProvider, reason: reasonType });
}

// Circuit breaker (called by provider-failover.ts, live-execution-guard.ts)
export function setCircuitBreakerStateProvider(provider: string, isOpen: boolean): void;
export function setCircuitBreakerState(isOpen: boolean): void;
export function setCircuitBreakerState(providerOrIsOpen: string | boolean, isOpen?: boolean): void {
  if (typeof providerOrIsOpen === 'boolean') {
    // Called as setCircuitBreakerState(isOpen) — use 'global' provider
    circuitBreakerGauge().set({ provider: 'global' }, providerOrIsOpen ? 1 : 0);
  } else {
    // Called as setCircuitBreakerStateProvider(provider, isOpen)
    circuitBreakerGauge().set({ provider: providerOrIsOpen }, isOpen ? 1 : 0);
  }
}

// SLA metrics (called by sla-tracker.ts)
export function setProviderHealthScore(provider: string, _unused: number, score: number): void {
  healthScoreGauge().set({ provider }, score);
}
export function setProviderAvailability(provider: string, _unused: number, available: boolean): void {
  availabilityGauge().set({ provider }, available ? 1 : 0);
}
export function setProviderErrorRate(provider: string, _unused: number, errorRate: number): void {
  errorRateGauge().set({ provider }, errorRate);
}
export function recordSlaCompliance(provider: string, _unused: number, compliant: boolean): void {
  slaCounter().inc({ provider, sla_tier: 'default', compliant: compliant ? 'true' : 'false' });
}

// Shard latency (used by strategy-router.ts)
export function recordShardLatency(shardId: string, operation: string, latencySeconds: number): void {
  shardLatencyHist().observe({ shard_id: shardId, operation }, latencySeconds);
}

// BullMQ queue metrics (used by agent-queue-manager.ts, agent-coordinator.ts)
export function recordQueueWaitTime(queue: string, priority: string, waitSeconds: number): void {
  queueWaitTimeHist().observe({ queue, priority }, waitSeconds);
}

// External API latency (used by latency-monitor.ts, polymarket-adapter.ts)
export function recordExternalApiLatency(service: string, endpoint: string, region: string, latencySeconds: number): void {
  externalApiLatencyHist().observe({ service, endpoint, region }, latencySeconds);
}

// Trade tracking (used by live-position-tracker.ts)
export function recordTrade(tokenId: string, exchange: string, side: 'buy' | 'sell', pnl: number): void {
  tradeCounter().inc({ token_id: tokenId, exchange, side, result: pnl >= 0 ? 'win' : 'loss' });
}
export const dailyPnlUsd: Gauge<string> = dailyPnlGauge();
export const winRatePercent: Gauge<string> = winRateGauge();

// Qwen strategy metrics (used by rollback/tiered-rollback-controller.ts)
export function setQwenPaperPnlPct(period: string, pct: number): void {
  qwenPaperPnlPctGauge().set({ period }, pct);
}
export const qwenPaperPnlPct: Gauge<string> = qwenPaperPnlPctGauge();
export const qwenSignalsTotal: Counter<string> = qwenSignalsCounter();
export const qwenStrategyReviewsResolvedTotal: Counter<string> = qwenStrategyReviewsCounter();
export const qwenAdminKillActionsTotal: Counter<string> = qwenAdminKillActionsCounter();
export function setQwenKillSwitch(active: boolean): void {
  qwenKillSwitchGauge().set({}, active ? 1 : 0);
}
export function setQwenDrawdownAutoDisabled(disabled: boolean): void {
  qwenDrawdownAutoDisabledGauge().set({}, disabled ? 1 : 0);
}
export function setQwenPaperGateDaysRemaining(days: number): void {
  qwenPaperGateDaysRemainingGauge().set({}, days);
}

// Memory metrics (used by memory-pressure-handler.ts)
export function setMemoryMetrics(rss: number, heapUsed: number): void {
  memoryRssGauge().set({}, rss);
  memoryHeapGauge().set({}, heapUsed);
}
export function recordMemoryPressureEvent(level: string): void {
  memoryPressureEventCounter().inc({ level });
}
export function recordCacheEviction(cacheName: string): void {
  cacheEvictionCounter().inc({ cache_name: cacheName });
}
export function recordCompressionRatio(originalSize: number, compressedSize: number): void {
  if (compressedSize > 0) {
    compressionRatioGauge().set({ algorithm: 'gzip' }, originalSize / compressedSize);
  }
}

// Strategy active state (used by live-trading-orchestrator.ts)
export function setStrategyActive(strategy: string, active: boolean): void {
  strategyActiveGauge().set({ strategy }, active ? 1 : 0);
}

// API metrics (used by middleware)
export function metricsMiddleware(req: { method: string; url: string }, _res: unknown, durationMs: number): void {
  const method = req.method;
  const path = req.url;
  apiRequestCounter().inc({ method, path, status: '200' });
  apiRequestDuration().observe({ method, path }, durationMs / 1000);
}
export function getMetrics(): Promise<string> {
  return register.metrics();
}

// External API latency — re-export from lazy init
export { externalApiLatencyHist as externalApiLatency };
