{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "outDir": "dist/worker",
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "src/platform/workers/**/*.ts",
    "src/durable-objects/**/*.ts",
    "src/regions/**/*.ts"
  ]
}
