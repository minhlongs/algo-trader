{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "dist/worker",
    "noEmit": false,
    "incremental": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "strict": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@cloudflare"
    ],
    "types": [
      "node",
      "workers-types"
    ],
    "isolatedModules": true
  },
  "include": [
    "src/platform/workers/**/*.ts",
    "src/durable-objects/**/*.ts",
    "src/regions/**/*.ts"
  ],
  "exclude": []
}