{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "dist/worker",
    "noEmit": false,
    "incremental": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "isolatedModules": true
  },
  "include": [
    "src/platform/workers/**/*.ts",
    "src/durable-objects/**/*.ts",
    "src/regions/**/*.ts"
  ],
  "exclude": []
}
