{
  "name": "@mekong/algo-trader",
  "version": "3.1.45",
  "description": "Modular algorithmic trading bot with RSI+SMA strategy, backtesting, and multi-exchange support via CCXT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "config",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "algo-trader": "./dist/index.js",
    "cashclaw": "./dist/desk/cli/cashclaw-cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "sop:run": "node src/agi-sops/index.js",
    "sop:dev": "node --watch src/agi-sops/index.js",
    "disk:check": "pnpm exec ts-node scripts/disk-monitor.ts",
    "disk:check:sh": "sh scripts/pre-build-check.sh",
    "prebuild": "npm run disk:check:sh",
    "build": "tsc && node -e \"require('fs').cpSync('src/alpha-lab/configs','dist/alpha-lab/configs',{recursive:true})\"",
    "build:fast": "tsc --incremental && node -e \"require('fs').cpSync('src/alpha-lab/configs','dist/alpha-lab/configs',{recursive:true})\"",
    "build:clean": "rm -rf dist && tsc && node -e \"require('fs').cpSync('src/alpha-lab/configs','dist/alpha-lab/configs',{recursive:true})\"",
    "build:watch": "tsc --watch",
    "build:cached": "bash scripts/build-with-cache.sh",
    "cache:check": "pnpm exec ts-node src/utils/build-cache.ts check",
    "cache:restore": "pnpm exec ts-node src/utils/build-cache.ts restore",
    "cache:save": "pnpm exec ts-node src/utils/build-cache.ts save",
    "cache:cleanup": "pnpm exec ts-node src/utils/build-cache.ts cleanup",
    "start": "node dist/index.js",
    "dev": "pnpm exec ts-node src/index.ts",
    "setup": "pnpm exec ts-node src/index.ts setup",
    "quickstart": "pnpm exec ts-node src/index.ts quickstart",
    "wallet:generate": "node scripts/generate-wallet.mjs",
    "telegram": "pnpm exec ts-node src/index.ts telegram:bot",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:load": "k6 run tests/load/raas-gateway-load-test.js",
    "test:load:ci": "k6 run --quiet tests/load/raas-gateway-load-test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 100",
    "dashboard:dev": "cd dashboard && npx vite",
    "dashboard:build": "cd dashboard && npx vite build",
    "api:serve": "pnpm exec ts-node src/index.ts api:serve",
    "build:worker": "tsc -p tsconfig.worker.json && npm run disk:check",
    "dev:worker": "wrangler dev",
    "sync-dunning-kv": "ts-node src/jobs/dunning-kv-sync.ts",
    "audit": "pnpm exec ts-node src/audit/index.ts",
    "chaos-test": "pnpm exec ts-node src/testing/chaos/index.ts",
    "deploy:worker": "wrangler deploy --config wrangler.toml",
    "deploy:cf": "bash scripts/deploy-cf-worker-with-sha-verification.sh",
    "verify:polymarket": "pnpm exec ts-node scripts/verify-polymarket-connection.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^0.2.7",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.70.0",
    "@tensorflow/tfjs": "4.22.0",
    "better-auth": "^1.6.29",
    "bullmq": "^6.1.1",
    "ccxt": "^4.5.73",
    "commander": "^15.0.0",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "5.2.1",
    "fastify": "^5.12.0",
    "grammy": "^1.45.1",
    "helmet": "^8.3.0",
    "hono": "^4.13.2",
    "ioredis": "^5.6.0",
    "javascript-lp-solver": "^1.0.3",
    "nats": "^2.29.3",
    "ollama": "^0.6.3",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "prom-client": "^15.1.3",
    "twilio": "^5.13.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "pkg-dir": "9.0.0",
    "supertest": "7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  },
  "module": "CommonJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/longtho638-jpg/algo-trader.git"
  },
  "bugs": {
    "url": "https://github.com/longtho638-jpg/algo-trader/issues"
  },
  "homepage": "https://github.com/longtho638-jpg/algo-trader#readme",
  "keywords": [
    "algorithmic-trading",
    "crypto-trading",
    "trading-bot",
    "backtesting",
    "arbitrage",
    "ccxt",
    "raas",
    "mekong"
  ],
  "author": "Mekong CLI",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
