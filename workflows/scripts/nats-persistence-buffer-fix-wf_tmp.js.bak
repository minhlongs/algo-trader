export const meta = {
  name: 'nats-persistence-buffer-fix',
  description: 'Fix TypeScript errors in NATS Persistence Buffer: type safety, error handling, test coverage',
  phases: [
    { title: 'Code Audit', detail: 'Review NATS buffer code, identify TypeScript issues' },
    { title: 'Type Safety Fixes', detail: 'Fix type errors, add proper interfaces' },
    { title: 'Error Handling Enhancement', detail: 'Improve error handling, retry logic' },
    { title: 'Testing', detail: 'Add comprehensive unit tests' },
    { title: 'Documentation', detail: 'Update docs with examples' },
  ],
};

phase('Code Audit');
const audit = await agent('NATS Buffer Audit', {
  label: 'nats-audit',
  agentType: 'fullstack-developer',
  isolation: 'worktree',
  prompt: `Audit NATS Persistence Buffer code:

1. Read: src/services/nats-persistence-buffer.service.ts
2. Identify TypeScript errors:
   - Any 'any' types
   - Missing type definitions
   - Incorrect null/undefined handling
   - Async/await misuse
   - Generic type issues

3. Common issues in NATS code:
   - JetStream context types
   - Consumer configuration types
   - Message acknowledgment types
   - Pull vs push subscription differences

4. Report:
   - List all type errors
   - Priority: high (blocks compilation), medium, low
   - Suggested fixes

5. Also check:
   - Error handling: are errors caught and logged?
   - Resource cleanup: subscriptions closed?
   - Memory leaks: unacked messages

`,
});

phase('Type Safety Fixes');
const types = await parallel([
  () => agent('Fix TypeScript Types', {
    label: 'ts-fixes',
    agentType: 'fullstack-developer',
    isolation: 'worktree',
    prompt: `Fix TypeScript in NATS buffer:

1. Add proper types:
   import { JetStreamContext, Consumer, Message } from 'nats';

   class PersistenceBuffer {
     private js: JetStreamContext;
     private consumer: Consumer | null = null;
     private buffer: Map<string, PersistedMessage> = new Map();
   }

2. Interface definitions:
   interface PersistedMessage {
     id: string;
     subject: string;
     data: Buffer;
     timestamp: number;
     attempts: number;
   }

3. Fix async issues:
   - Proper Promise handling
   - async/await consistently
   - Error types: NATSError, not any

4. Configuration types:
   interface PersistenceBufferConfig {
     streamName: string;
     consumerName: string;
     bufferSize: number;
     retentionPeriod: number;
     maxAttempts: number;
   }

5. Eliminate 'any':
   - Use unknown instead, narrow with type guards
   - Generic types for message handlers

`,
  }),
  () => agent('Add Type Guards', {
    label: 'type-guards',
    agentType: 'fullstack-developer',
    isolation: 'worktree',
    prompt: `Add type guards for NATS:

1. Message type guard:
   function isNatsMessage(obj: unknown): obj is Message {
     return obj && typeof obj === 'object' && 'subject' in obj && 'data' in obj;
   }

2. Error type guard:
   function isNatsError(obj: unknown): obj is NATSError {
     return obj && typeof obj === 'object' && 'code' in obj && 'message' in obj;
   }

3. Use in code:
   try {
     const msg = await subscription.nextMessage();
     if (!isNatsMessage(msg)) {
       throw new Error('Expected NATS message');
     }
     // TypeScript now knows msg is Message
   } catch (err) {
     if (isNatsError(err)) {
       console.error('NATS error:', err.code, err.message);
     }
   }

4. Utility types:
   - PartialDeep<T>
   - Nullable<T>
   - AsyncIterable<T>

`,
  }),
]);

phase('Error Handling Enhancement');
const error = await parallel([
  () => agent('Improve Error Handling', {
    label: 'error-handling',
    agentType: 'fullstack-developer',
    isolation: 'worktree',
    prompt: `Improve error handling:

1. Error classification:
   - ConnectionError: NATS server unreachable
   - StreamError: stream not found, consumer error
   - AckError: message ack failed
   - DecodeError: message data corrupt

2. Retry logic:
   - Transient errors: retry with backoff (1s, 2s, 4s)
   - Permanent errors: log and skip
   - Max retries: 3 per message

3. Dead letter queue:
   - Messages failing >maxAttempts → move to DLQ
   - DLQ stream: PERSISTENCE_BUFFER_DLQ
   - Manual review possible

4. Error metrics:
   - errors_total{type="connection|stream|ack|decode"}
   - dead_letter_messages_total

5. Graceful degradation:
   - If NATS down: buffer in memory (limited)
   - If full: drop oldest, log warning
   - Alert on high error rate

`,
  }),
  () => agent('Implement Proper Cleanup', {
    label: 'cleanup',
    agentType: 'fullstack-developer',
    isolation: 'worktree',
    prompt: `Resource cleanup:

1. Subscription lifecycle:
   - Close subscription on buffer destroy
   - Drain pending messages before close
   - Cancel pending async operations

2. Implementation:
   async destroy(): Promise<void> {
     if (this.subscription) {
       await this.subscription.drain();  // wait for in-flight
       this.subscription.unsubscribe();
     }
     this.js.close();  // close JetStream context
     this.buffer.clear();  // clear in-memory buffer
   }

3. Context management:
   - Use async/await with try/finally
   - Ensure resources freed even on errors

4. Test cleanup:
   - Jest afterEach: await buffer.destroy()
   - Verify no open subscriptions after test

5. Memory leak detection:
   - Track unacked messages
   - Warn if buffer grows beyond limit
   - Force cleanup if threshold exceeded

`,
  }),
]);

phase('Testing');
const testing = await parallel([
  () => agent('Write Unit Tests', {
    label: 'unit-tests',
    agentType: 'tester',
    isolation: 'worktree',
    prompt: `Unit tests for NATS buffer:

1. Buffer operations:
   - enqueue(message) → message stored
   - dequeue() → returns message in order
   - peek() → returns next without removing
   - size() → correct count

2. Persistence:
   - Message persisted to JetStream
   - Survive process restart (replay from stream)
   - Duplicate prevention (idempotency key)

3. Error handling:
   - NATS down → enqueue fails gracefully
   - Invalid message → rejected with error
   - Retry on transient error
   - DLQ after max attempts

4. Concurrent access:
   - Multiple producers: no race conditions
   - Multiple consumers: fair distribution
   - Buffer size limit enforced

5. Backpressure:
   - Buffer full → producer blocked or rejected
   - Consumer lag detected

Use nats-server test container for integration tests.

`,
  }),
  () => agent('Integration Tests', {
    label: 'integration-tests',
    agentType: 'tester',
    isolation: 'worktree',
    prompt: `Integration tests:

1. Start embedded NATS server:
   const nats = new JsServer();
   await nats.start();
   const nc = await connect({ servers: nats.getClient() });

2. Test full flow:
   - Create buffer
   - Enqueue 10 messages
   - Dequeue all 10 → correct order
   - Verify persisted in JetStream

3. Simulate crash:
   - Enqueue 5 messages
   - Destroy buffer
   - Create new buffer
   - Dequeue → should get 5 messages

4. JetStream failure:
   - Stop NATS server
   - Enqueue → error
   - Restart NATS
   - Enqueue succeeds

5. Multiple consumers:
   - Create 3 buffer instances
   - All consume from same stream
   - Messages distributed round-robin

`,
  }),
]);

phase('Documentation');
const docs = await parallel([
  () => agent('Update TypeScript Documentation', {
    label: 'ts-docs',
    agentType: 'docs-manager',
    isolation: 'worktree',
    prompt: `Update documentation:

1. API reference:
   - PersistenceBuffer class
   - Constructor(config)
   - enqueue(message): Promise<void>
   - dequeue(): Promise<PersistedMessage>
   - destroy(): Promise<void>

2. Configuration:
   ```typescript
   const buffer = new PersistenceBuffer({
     natsUrl: 'nats://localhost:4222',
     streamName: 'PERSISTENCE_STREAM',
     consumerName: 'PERSISTENCE_CONSUMER',
     bufferSize: 1000,
     retentionPeriod: '24h',
     maxAttempts: 3,
   });
   ```

3. Usage example:
   ```typescript
   await buffer.enqueue({ id: '123', data: JSON.stringify(event) });
   const msg = await buffer.dequeue();
   await msg.ack();
   ```

4. Error handling guide:
   - Catch errors from enqueue/dequeue
   - Handle connection failures
   - Dead letter queue retrieval

5. TypeScript setup:
   - Ensure tsconfig has "strict": true
   - Install @types/nats if needed

File: docs/services/nats-persistence-buffer.md

`,
  }),
  () => agent('NATS Buffer Sign-off', {
    label: 'nats-signoff',
    agentType: 'cto',
    isolation: 'worktree',
    prompt: `Sign-off NATS Persistence Buffer fix.

Review:
✅ TypeScript errors identified and fixed
✅ Proper type definitions added
✅ No 'any' types remaining
✅ Error handling improved (classification, retry, DLQ)
✅ Resource cleanup (drain, unsubscribe)
✅ Comprehensive unit tests
✅ Integration tests with real NATS
✅ Documentation updated
✅ Code compiles with tsc --noEmit

Decision: NATS PERSISTENCE BUFFER PRODUCTION READY.

`,
  }),
]);

log('NATS Persistence Buffer Fix workflow launched');