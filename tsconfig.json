{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "types": ["node", "@cloudflare/workers-types"],
    "isolatedModules": false,
      "incremental": true,
    "composite": false,
    "declaration": true,
    "downlevelIteration": true,
    "lib": ["ES2023", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@desk/*": ["src/desk/*"],
      "@platform/*": ["src/platform/*"],
    "@forest/*": ["src/forest/*"],
    "@redis": ["src/redis/index"]
    },
    "rootDir": "./src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "node_modules/.cache",
    "**/*.test.ts",
    "src/platform/workers/**/*",
    "src/platform/dashboard/**/*",
    "src/platform/landing/**/*",
    "src/wiring/**/*",
    "src/desk/wiring/**/*",
    "dist",
    "src/desk/polymarket/trading-pipeline.ts",
    "src/desk/polymarket/trading-pipeline-types.ts",
    "src/desk/polymarket/trading-pipeline-init.ts",
    "src/desk/polymarket/trading-pipeline-prediction.ts"
  ]
}
