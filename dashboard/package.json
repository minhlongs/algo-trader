{
  "name": "algo-trader-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run prebuild:manifesto && vite",
    "prebuild:manifesto": "cp ../docs/manifesto.md public/manifesto.md",
    "build": "pnpm run prebuild:manifesto && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:staging": "wrangler pages deploy dist --project-name=algo-trader-dashboard --branch=staging",
    "deploy:production": "wrangler pages deploy dist --project-name=algo-trader-dashboard",
    "test": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.6.3",
    "hono": "^4.7.0",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lightweight-charts": "^4.2.2",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
